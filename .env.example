# Django Settings
SECRET_KEY=your-secret-key-here-generate-new-one-for-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,yourapp.back4app.io

# PostgreSQL Database Configuration (Back4app)
# For local Docker: postgresql://jewellery_user:changeme@db:5432/jewellery_db
# For Back4app: Use the DATABASE_URL from Back4app dashboard
DATABASE_URL=postgresql://jewellery_user:changeme@db:5432/jewellery_db

# PostgreSQL credentials (for docker-compose)
POSTGRES_DB=jewellery_db
POSTGRES_USER=jewellery_user
POSTGRES_PASSWORD=changeme

# Cloudinary Configuration (for image storage)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Sentry Error Tracking
SENTRY_DSN=

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to Git (it's in .gitignore)
# 3. Generate a new SECRET_KEY for production using:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 4. Set DEBUG=False in production
# 5. Update ALLOWED_HOSTS with your actual domain(s)
# 6. For Back4app deployment, update DATABASE_URL with the one from Back4app dashboard
